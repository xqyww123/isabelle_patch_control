#!/usr/bin/env python3
"""make-patches [-C <dir>] --package <dir> [<R>/]<feature> <version>
make-patches [-C <dir>] --hg <repo> --tarball <file> [<R>/]pristine <hg id>

Release of a feature (migration plan §5.1), run on the owner's order.  <R> defaults to the
release line of the branch checked out where the command runs.  The feature's package directory
<dir> holds tools/patched_files.txt, tools/signature_additions.txt and tools/required_sessions.txt
(see RELEASE.md, "First-time setup of a feature repository") and receives patches/<R>/*.patch and
patches/<R>/provenance.txt.

Gates, in order, all before anything is written or tagged:
  7. the feature repository (<dir> lies in it): tools/patched_files.txt, signature_additions.txt,
     required_sessions.txt and, if present, tools/component_files.txt with the files it lists are
     committed and unchanged; <tip> carries no release tag of this feature yet (commit first).
  0. base tag: `git merge-base --all <base> <tip>` is one commit, and exactly one release tag
     <R>/<base>/* points at it.  Every gate below is relative to that tag.
  1. own commits: every commit in <base tag>..<tip> is on the first-parent chain of this feature's
     branch (in some release line) beyond that line's base branch.
  (f) `git diff-tree -r --no-renames --name-only` between the two equals tools/patched_files.txt.
  (d) check-signatures with tools/signature_additions.txt.
  (e) the tested records of <tip> (printed) together cover tools/required_sessions.txt.  For a
     package with component files only records count whose `dir:` line of the feature repository
     shows no uncommitted shipped file and whose HEAD has the same shipped files as HEAD now.
  (c) the patch files (one `git diff-tree -p` block per file, flat names as light locale uses
     them), generated into a temporary directory, replayed through the patch tool's directory
     interface on `git archive <base tag>` forward and backward, compared by tree hash.
Then, each step repeatable after a failure (patch tool plan decision 16 point 8): the package's
patches/<R>/ receives the files and the provenance file; they are staged and committed by name
in the feature repository; the commit to tag (the new one, or the one an existing tag of this
version points at) is checked to hold exactly the generated files and the gates' component files;
the annotated tag <R>/<feature>/<version> is created in the feature repository; and last in the
Isabelle repository, whose tag marks the release as done.

`pristine <hg id>` runs check (a) only (§5.2): the tip of <R>/pristine equals the hg tag <R>
minus Admin/, README_REPOSITORY and .hg*, plus the five release text files of the official
tarball and the commit's own .gitignore; then tags <R>/pristine/<hg id>.

Gate numbers 7, 0, 1 and the letters (f), (d), (e), (c) are the migration plan §5.1's; the write
steps are decision 16 point 8's.
"""
import argparse
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

from common import TOOLS_DIR, Refused, Repo, main, patch_blocks, run, split_branch
from isabelle_patch_control.api import apply_to, unapply_from

# paths git tracks that an hg checkout of the release does not have, or has differently; the CI
# build assertion hashes its hg checkout minus Admin/, README_REPOSITORY and .hg* and compares
TREE_HASH_EXCLUDES = [".gitignore", "Isabelle.options", "etc/ISABELLE_ID", "etc/ISABELLE_TAGS",
                      "etc/components", "lib/scripts/Isabelle_app"]
RELEASE_FILES = ["etc/ISABELLE_ID", "etc/ISABELLE_TAGS", "etc/components", "lib/scripts/Isabelle_app", "Isabelle.options"]
HG_ONLY = ["Admin", "README_REPOSITORY", ".hg_archival.txt", ".hgignore", ".hgtags"]


def listed(path: Path) -> list[str]:
    if not path.is_file():
        raise Refused(f"{path} is missing")
    return [line.strip() for line in path.read_text().splitlines() if line.strip() and not line.lstrip().startswith("#")]


def resolve_branch(repo: Repo, cwd: Path, name: str) -> str:
    if "/" in name:
        split_branch(name)
        return name
    head = Repo.head_branch(cwd)
    if not head or "/" not in head:
        raise Refused(f"{cwd} is not on a <R>/... branch; give the release line as {name}'s prefix")
    return f"{split_branch(head)[0]}/{name}"


def replay(directory: Path, patches: Path, reverse: bool = False):
    """Gate (c) through the patch tool's directory interface: every patch file of `patches` applied
    to (or reversed from) `directory`, CONFLICT files refused."""
    res = (unapply_from if reverse else apply_to)(directory, patches)
    if res.conflicts:
        files = "".join(f"\n  {lv.target}: " + (next(iter(lv.failures.values()), "").splitlines() or ["?"])[0]
                        for lv in res.conflicts)
        raise Refused(f"gate (c): the patches do not {'reverse' if reverse else 'apply'} cleanly:{files}")


# --- the feature repository (decision 16 point 7)

def feature_repo(package: Path) -> Path:
    r = run(["git", "rev-parse", "--show-toplevel"], cwd=package, check=False)
    if r.returncode:
        raise Refused(f"{package} is not inside a git repository (every feature has its own)")
    return Path(r.stdout.strip()).resolve()


def shipped_files(package: Path) -> list[Path]:
    """tools/component_files.txt and the files it lists: the component payload the package ships."""
    cf = package / "tools" / "component_files.txt"
    return [cf, *(package / line for line in listed(cf))] if cf.is_file() else []


def require_committed(top: Path, paths: list[Path]):
    rel = [os.path.relpath(p, top) for p in paths]
    for p, r in zip(paths, rel):
        if not p.is_file():
            raise Refused(f"{p} is missing")
        if run(["git", "ls-files", "--error-unmatch", "--", r], cwd=top, check=False).returncode:
            raise Refused(f"{p} is not committed in the feature repository {top}: commit it first")
    dirty = run(["git", "status", "--porcelain", "--", *rel], cwd=top).stdout
    if dirty:
        raise Refused(f"uncommitted changes in the feature repository {top}: commit them first\n{dirty.rstrip()}")


def committed_files(top: Path, commit: str, directory: Path) -> dict[str, str]:
    """path -> blob hash of the files `commit` holds under `directory` of the feature repository."""
    out = {}
    for line in run(["git", "ls-tree", "-r", commit, "--", os.path.relpath(directory, top)], cwd=top).stdout.splitlines():
        meta, path = line.split("\t", 1)
        out[path] = meta.split()[2]
    return out


def archive(repo: Repo, rev: str, into: Path):
    """`git archive rev` extracted into the directory (modes preserved)."""
    with subprocess.Popen(["git", "archive", "--format=tar", rev], cwd=repo.common_dir, stdout=subprocess.PIPE) as g:
        subprocess.run(["tar", "-x", "-C", str(into)], stdin=g.stdout, check=True)
        if g.wait():
            raise Refused(f"git archive {rev} failed")


def feature_release(repo: Repo, cwd: Path, branch: str, version: str, package: Path):
    release, feature = split_branch(branch)
    if not re.fullmatch(r"[1-9][0-9]*", version):
        raise Refused(f"the version is a positive integer, not {version!r}")
    if not repo.exists(branch):
        raise Refused(f"{branch} does not exist")
    tag = f"{branch}/{version}"
    if repo.exists(tag):
        raise Refused(f"release tag {tag} already exists")
    tip = repo.rev(branch)
    wt = repo.worktree_of(branch)
    if wt and Repo.status(wt["path"]):
        raise Refused(f"{wt['path']} has uncommitted changes")
    base = repo.base_of(branch)
    base_name = split_branch(base)[1]

    # 7. the feature repository
    top = feature_repo(package)
    shipped = shipped_files(package)
    lists = [package / "tools" / f for f in ("patched_files.txt", "signature_additions.txt", "required_sessions.txt")]
    require_committed(top, [*lists, *shipped])
    earlier = repo.tags_at(tip, f"{branch}/*")
    if earlier:
        raise Refused(f"{tip[:12]} already carries release tag {' '.join(earlier)}: commit first (an empty commit "
                      "will do) to release this commit's content again under a new version")
    H = run(["git", "rev-parse", "HEAD"], cwd=top).stdout.strip()
    shipped_rel = [os.path.relpath(p, top) for p in shipped]

    # 0. the base tag
    merge_base = repo.merge_base(base, tip)
    base_tags = repo.tags_at(merge_base, f"{base}/*")
    if len(base_tags) != 1:
        raise Refused(f"gate 0: merge-base({base}, {branch}) = {merge_base[:12]} carries {len(base_tags)} release "
                      f"tags of {base} ({' '.join(base_tags) or 'none'}), not exactly one: merge a release of {base}")
    base_tag = base_tags[0]
    print(f"base tag {base_tag} at {merge_base[:12]}")

    # 1. own commits only
    commits = set(repo.git("rev-list", f"{base_tag}..{tip}").split())
    allowed = set()
    for line in {split_branch(b)[0] for b in repo.branches()}:
        f, b = f"{line}/{feature}", f"{line}/{base_name}"
        if repo.exists(f) and repo.exists(b):
            allowed |= set(repo.git("rev-list", "--first-parent", f, "--not", b).split())
    leaked = commits - allowed
    if leaked:
        names = repo.git("log", "--no-walk", "--format=  %h %s", *sorted(leaked))
        raise Refused(f"gate 1: commits in {base_tag}..{branch} that are not this feature's own:\n{names}")
    print(f"gate 1: {len(commits)} commits since {base_tag}, all on {branch}'s first-parent chain")

    # (f) the changed files
    changed = sorted(repo.git("diff-tree", "-r", "--name-only", "--no-renames", base_tag, tip).split("\n"))
    changed = [c for c in changed if c]
    expected = sorted(listed(package / "tools" / "patched_files.txt"))
    if changed != expected:
        extra = sorted(set(changed) - set(expected))
        missing = sorted(set(expected) - set(changed))
        raise Refused("gate (f): the files changed since the base tag are not tools/patched_files.txt:"
                      + "".join(f"\n  changed but not listed: {p}" for p in extra)
                      + "".join(f"\n  listed but unchanged: {p}" for p in missing))
    print(f"gate (f): {len(changed)} changed files, exactly tools/patched_files.txt")

    # (d) signatures
    r = run([sys.executable, TOOLS_DIR / "check-signatures", "-C", repo.common_dir, base_tag, tip,
             package / "tools" / "signature_additions.txt"], check=False)
    if r.returncode:
        raise Refused(f"gate (d):\n{r.stdout}{r.stderr}")
    print(f"gate (d): {r.stdout.strip()}")

    # (e) tested
    required = set(listed(package / "tools" / "required_sessions.txt"))
    if not required:
        raise Refused("tools/required_sessions.txt names no session")
    records = repo.tested_records(tip)
    if not records:
        raise Refused(f"gate (e): {tip[:12]} has no tested record (run-tree writes one after a clean build)")
    covered = set()
    for rec in records:
        not_counted = ""
        if shipped:                                   # migration plan §0 item 32: the record must cover the shipped files
            entry = rec["dirs"].get(str(top))
            if entry is None:
                not_counted = f"the build did not use -d {top}"
            elif touched := sorted(set(entry[1]) & set(shipped_rel)):
                not_counted = f"shipped files were uncommitted during the build: {' '.join(touched)}"
            elif run(["git", "diff", "--quiet", entry[0], H, "--", *shipped_rel], cwd=top, check=False).returncode:
                not_counted = f"the shipped files differ between the build's {entry[0][:12]} and HEAD {H[:12]}"
        print(f"tested {rec['when']} in {rec['tree']}: {rec['command']} -> {' '.join(sorted(rec['sessions']))}"
              + (f"\n  not counted: {not_counted}" if not_counted else ""))
        if not not_counted:
            covered |= rec["sessions"]
    missing = sorted(required - covered)
    if missing:
        raise Refused(f"gate (e): the tested records do not cover {' '.join(missing)}")
    print(f"gate (e): records cover {' '.join(sorted(required))}")

    # provenance
    tree_hash = repo.tree_hash_excluding(tip, TREE_HASH_EXCLUDES)
    build_prefix = release.replace("-", "_")
    base_version = base_tag.rsplit("/", 1)[1]
    base_is_pristine = base_name == "pristine"
    provenance = [
        f"feature: {branch}",
        f"release_tag: {tag}",
        f"commit: {tip}",
        f"base_tag: {base_tag}",
        f"base_commit: {merge_base}",
        f"base_package_version: {'none (the base is pristine)' if base_is_pristine else base_version}",
        f"base_pin: {'none' if base_is_pristine else f'=={base_version}={build_prefix}_*'}",
        f"build_string_prefix: {build_prefix}",
        f"tree_hash: {tree_hash}",
        f"tree_hash_excludes: {' '.join(TREE_HASH_EXCLUDES)}",
    ]

    with tempfile.TemporaryDirectory(prefix="make-patches-") as tmp:
        # generation, into the temporary directory: the package is not touched before every gate passed
        gen = Path(tmp) / "patches"
        gen.mkdir()
        diff = run(["git", "diff-tree", "-r", "-p", "--no-renames", base_tag, tip], cwd=repo.common_dir, text=False).stdout
        for file, block in patch_blocks(diff).items():                 # bytes throughout: CRs and non-UTF-8 survive
            (gen / file).write_bytes(block)
        patch_names = sorted(p.name for p in gen.glob("*.patch"))
        print(f"{len(patch_names)} patch files generated")

        # (c) round trip on the base tag's archive through the tool's directory interface, compared by tree hash
        work = Path(tmp) / "tree"
        work.mkdir()
        archive(repo, base_tag, work)
        replay(work, gen)
        got, want = repo.tree_hash_of_dir(work), repo.git("rev-parse", f"{tip}^{{tree}}")
        if got != want:
            raise Refused(f"gate (c): forward application gives tree {got}, the commit's tree is {want}")
        replay(work, gen, reverse=True)
        got, want = repo.tree_hash_of_dir(work), repo.git("rev-parse", f"{base_tag}^{{tree}}")
        if got != want:
            raise Refused(f"gate (c): backward application gives tree {got}, the base tag's tree is {want}")
        print("gate (c): round trip on the base tag's archive reproduces both trees")
        (gen / "provenance.txt").write_text("\n".join(provenance) + "\n")
        print("\n".join(provenance))

        # write step (b): old patch files go, the generated files and the provenance file come
        out = package / "patches" / release
        out.mkdir(parents=True, exist_ok=True)
        stale = sorted(p.name for p in out.glob("*.patch") if p.name not in patch_names)
        for name in stale:
            (out / name).unlink()
        generated = [*patch_names, "provenance.txt"]
        for name in generated:
            shutil.copy2(gen / name, out / name)
        print(f"{len(patch_names)} patch files written to {out}" + (f"; removed {' '.join(stale)}" if stale else ""))

        # write step (c): staged and committed by name, never by directory (that would sweep in unrelated edits);
        # the files to remove are the old *.patch of HEAD, not of the disk: a rerun after a failure here sees them too
        paths = [os.path.relpath(out / name, top) for name in generated]
        removed = sorted(p for p in committed_files(top, "HEAD", out) if p.endswith(".patch") and p not in paths)
        run(["git", "add", "--", *paths], cwd=top)
        if removed:
            run(["git", "rm", "--cached", "-q", "--ignore-unmatch", "--", *removed], cwd=top)
        L = [*paths, *removed]
        if run(["git", "diff", "--cached", "--quiet", "--", *L], cwd=top, check=False).returncode:
            run(["git", "commit", "-q", "-m", f"{feature} release {version}: patches/{release}", "--", *L], cwd=top)
            print(f"committed patches/{release} in {top}")
        else:
            print(f"patches/{release} already committed in {top}")

        # write step (d): the commit to tag holds exactly the generated files (and the gates' component files)
        r = run(["git", "rev-parse", "-q", "--verify", f"refs/tags/{tag}^{{commit}}"], cwd=top, check=False)
        tag_exists = r.returncode == 0
        commit = r.stdout.strip() if tag_exists else run(["git", "rev-parse", "HEAD"], cwd=top).stdout.strip()
        in_commit = committed_files(top, commit, out)
        want = {p: run(["git", "hash-object", "--", gen / name], cwd=top).stdout.strip() for p, name in zip(paths, generated)}
        differing = sorted(set(in_commit) ^ set(want) | {p for p in want if in_commit.get(p) != want[p]})
        if not differing and shipped_rel and run(["git", "diff", "--quiet", H, commit, "--", *shipped_rel], cwd=top, check=False).returncode:
            differing = ["(component files)", *shipped_rel]
        if differing:
            where = f"release tag {tag} already exists at {commit[:12]} and" if tag_exists else f"commit {commit[:12]}"
            raise Refused(f"{where} does not hold the generated files: {' '.join(differing)}"
                          + (f"\nthis version number is spent: release {int(version) + 1}" if tag_exists else ""))

        # write step (e): the feature repository's tag
        if not tag_exists:
            run(["git", "tag", "-a", "-m", f"{branch} release {version}\n\n" + "\n".join(provenance), tag, commit], cwd=top)
            print(f"release tag {tag} created in {top} at {commit[:12]}")
        else:
            print(f"release tag {tag} already in {top} at {commit[:12]}")

    # write step (f): the Isabelle repository's tag, last: its existence marks the release as done
    repo.git("tag", "-a", "-m", f"{branch} release {version}\n\n" + "\n".join(provenance), tag, tip)
    print(f"release tag {tag} created at {tip[:12]}")


def pristine_release(repo: Repo, branch: str, hg_id: str, hg_repo: Path, tarball: Path):
    release, name = split_branch(branch)
    if name != "pristine":
        raise Refused("the second form is for <R>/pristine")
    if not repo.exists(branch):
        raise Refused(f"{branch} does not exist")
    tip = repo.rev(branch)
    tag = f"{branch}/{hg_id}"
    node = run(["hg", "-R", hg_repo, "log", "-r", f"tag('{release}')", "--template", "{node|short}"]).stdout.strip()
    tags = run(["hg", "-R", hg_repo, "log", "-r", f"tag('{release}')", "--template", "{tags}"]).stdout.strip()
    if node != hg_id:
        raise Refused(f"hg tag {release} is changeset {node}, not {hg_id}")
    with tempfile.TemporaryDirectory(prefix="make-patches-") as tmp:
        expected = Path(tmp) / "expected"
        run(["hg", "-R", hg_repo, "archive", "-r", f"tag('{release}')", "-t", "files", expected])
        for p in HG_ONLY:
            path = expected / p
            if path.is_dir():
                shutil.rmtree(path)
            elif path.exists():
                path.unlink()
        with tarfile.open(tarball) as tf:
            for f in RELEASE_FILES:
                try:
                    member = tf.getmember(f"{release}/{f}")
                except KeyError:
                    raise Refused(f"{tarball} has no {release}/{f}")
                (expected / f).parent.mkdir(parents=True, exist_ok=True)
                (expected / f).write_bytes(tf.extractfile(member).read())
                os.chmod(expected / f, member.mode & 0o777)   # the executable bit is part of the tree hash
        (expected / ".gitignore").write_text(run(["git", "show", f"{tip}:.gitignore"], cwd=repo.common_dir).stdout)
        for f, want in (("etc/ISABELLE_ID", node), ("etc/ISABELLE_TAGS", tags)):
            got = (expected / f).read_text().strip()
            if got != want:
                raise Refused(f"check (a): the tarball's {f} is {got!r}, hg says {want!r}")
        got, want = repo.tree_hash_of_dir(expected), repo.git("rev-parse", f"{tip}^{{tree}}")
    if got != want:
        raise Refused(f"check (a): {branch} ({tip[:12]}) has tree {want}; hg tag {release} plus the release files "
                      f"of {tarball.name} has tree {got}")
    print(f"check (a): {branch} at {tip[:12]} equals hg {release} ({node}) plus the five release text files "
          f"of {tarball.name} and .gitignore")
    if repo.exists(tag):
        if repo.rev(tag) != tip:
            raise Refused(f"{tag} exists but points at {repo.rev(tag)[:12]}, not {tip[:12]}")
        print(f"release tag {tag} already exists at {tip[:12]}")
    else:
        repo.git("tag", "-a", "-m", f"{release} pristine, hg changeset {hg_id}", tag, tip)
        print(f"release tag {tag} created at {tip[:12]}")


def cli():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-C", metavar="dir", default=os.getcwd(), help="a directory inside the repository")
    p.add_argument("--package", metavar="dir", type=Path, help="the feature's package directory")
    p.add_argument("--hg", metavar="repo", type=Path, help="pristine: the Isabelle hg repository")
    p.add_argument("--tarball", metavar="file", type=Path, help="pristine: the official release tarball")
    p.add_argument("feature", metavar="[<R>/]<feature>")
    p.add_argument("version", metavar="<version>|<hg id>")
    a = p.parse_args()
    cwd = Path(a.C)
    repo = Repo(cwd)
    repo.check_hook()
    branch = resolve_branch(repo, cwd, a.feature)
    if split_branch(branch)[1] == "pristine":
        if not (a.hg and a.tarball):
            raise Refused("pristine needs --hg <repo> and --tarball <file>")
        pristine_release(repo, branch, a.version, a.hg, a.tarball)
    else:
        if not a.package:
            raise Refused("a feature release needs --package <dir>")
        feature_release(repo, cwd, branch, a.version, a.package.resolve())


main(cli)
