def isabelle_at(a, build: str) -> str:
    """The spec of isabelle --isabelle-version at that build."""
    return f"isabelle={a.isabelle_version}={build}"


def isabelle_of(record: dict) -> str:
    """isabelle_at's spec of an installed isabelle record."""
    return f"isabelle={record['version']}={record['build']}"


class Leg:
    def __init__(self, a):
        self.a = a
        self.work = Path(a.work or tempfile.mkdtemp(prefix="accept-")).resolve()
        self.work.mkdir(parents=True, exist_ok=True)
        self.passed, self.failed = 0, []
        self.out = ""
        self.envs = 0

    # --- conda and the tool
    def conda(self, verb: str, prefix: Path, *specs: str, channels=None) -> int:
        chans = [x for ch in (channels or self.a.channel) for x in ("-c", ch)]
        r = subprocess.run([CONDA, verb, "-q", "-y", "-p", str(prefix), "--override-channels", *chans, *specs],
                           capture_output=True, text=True)
        self.out = (r.stdout + r.stderr).replace("\r", "")
        (self.work / f"{prefix.name}-{verb}-{time.monotonic_ns()}.txt").write_text(self.out)
        return r.returncode

    def env(self, name: str, *specs: str, channels=None, under: Path | None = None) -> Path | None:
        self.envs += 1
        prefix = (under or self.work / "envs") / f"{name}"
        rc = self.conda("create", prefix, *specs, channels=channels)
        if not self.check(f"({name}) creating the environment", rc == 0):
            return None
        return prefix

    def python(self, prefix: Path) -> Path:
        return prefix / ("python.exe" if WINDOWS else "bin/python")

    def isabelle(self, prefix: Path) -> Path:
        return prefix / "isa" / "bin" / ("isabelle.bat" if WINDOWS else "isabelle")

    def tool(self, prefix: Path, *args: str) -> tuple[int, str]:
        exe = prefix / ("Scripts/isabelle-patch-control.exe" if WINDOWS else "bin/isabelle-patch-control")
        r = subprocess.run([str(exe), *args], capture_output=True, text=True)
        return r.returncode, (r.stdout + r.stderr).replace("\r", "")

    def states(self, prefix: Path) -> list[str]:
        """`<state> <feature>` of every feature sentence of `status`; a refusal comes back whole, as
        one element, so that it can never read as a state."""
        _, out = self.tool(prefix, "status")
        read = read_status(out)
        if read or out.strip() == texts.NO_FEATURES:
            return [f"{state} {name}" for state, name in read]
        return [out.strip()]

    def status_rc(self, prefix: Path) -> int:
        return self.tool(prefix, "status")[0]

    def all_applied(self, prefix: Path) -> bool:
        """Every installed feature applied, status exit 0."""
        chain = self.chain(prefix)
        return bool(chain) and self.status_rc(prefix) == 0 and self.states(prefix) == [f"applied {f}" for f, _ in chain]

    def records(self, prefix: Path) -> dict[str, dict]:
        return {d["name"]: d for p in (prefix / "conda-meta").glob("*.json") if (d := json.loads(p.read_text()))}

    def chain(self, prefix: Path) -> list[tuple[str, Path]]:
        """(feature, unpacked package dir) of every installed feature package, bottom first."""
        dirs = [d for r in self.records(prefix).values() if ((d := Path(r["extracted_package_dir"])) / FD).is_dir()]
        return [(feature, pkg) for feature, pkg, _ in check_bytes.chain(dirs)]

    def isabelle_dir(self, prefix: Path) -> Path:
        return Path(self.records(prefix)["isabelle"]["extracted_package_dir"])

    def user_dir(self, prefix: Path) -> Path | None:
        r = subprocess.run([str(self.isabelle(prefix)), "getenv", "-b", "ISABELLE_HOME_USER"], capture_output=True, text=True)
        if r.returncode:
            return None
        d = r.stdout.strip()
        if m := re.match(r"^/cygdrive/([a-zA-Z])/(.*)$", d):
            d = f"{m[1]}:/{m[2]}"
        return Path(d)

    def registered(self, prefix: Path, package: str, user: Path | None = None) -> bool:
        user = user or self.user_dir(prefix)
        comp = user / "etc" / "components" if user else None
        return bool(comp and comp.is_file() and any(line.replace("\\", "/").rstrip("/").endswith(f"share/{package}")
                                                     for line in comp.read_text().splitlines()))

    # --- assertions
    def check(self, what: str, ok: bool, detail: str = "") -> bool:
        if ok:
            print(f"ok       {what}")
            self.passed += 1
        else:
            print(f"WRONG    {what}")
            for line in (detail or self.out).splitlines()[-30:]:
                print(f"           {line}")
            self.failed.append(what)
        return ok

    def skip(self, what: str):
        print(f"skipped  {what}")
        if self.a.strict:
            self.failed.append(f"skipped under --strict: {what}")

    def lacks(self, what: str, option: str) -> bool:
        """An empty option asks for the skip; --strict lets it through."""
        if getattr(self.a, option[2:].replace("-", "_")):
            return False
        print(f"skipped  {what}: no {option}")
        return True

    def times(self, text: str) -> int:
        return self.out.count(text)

    def bytes_ok(self, what: str, prefix: Path, applied: list[str], packages: list[Path] | None = None):
        packages = packages if packages is not None else [d for _, d in self.chain(prefix)]
        try:
            problems, _, n = check_bytes.check(prefix / "isa", self.isabelle_dir(prefix), packages, applied)
        except check_bytes.Refused as e:
            problems, n = [str(e)], 0
        self.check(f"(k) {what}: {n} files as expected", not problems, "\n".join(problems))

    # --- the files the CONFLICT scenarios use
    def target(self, unpacked: Path, created: bool, below: list[Path]) -> str | None:
        """A path the feature's patches create (created) or change without creating, and no patch of `below` touches."""
        others = {check_bytes.header(p)[0] for d in below for p in (d / FD).glob("*/*.patch")}
        for p in sorted((unpacked / FD).glob("*/*.patch")):
            path, pre, post = check_bytes.header(p)
            if path not in others and (set(pre) == {"0"}) == created and set(post) != {"0"}:
                return path
        return None

    def replace_file(self, path: Path, text: str):
        """A new file over `path`: never an in-place write, which would go through a hard link into
        the leg's package cache."""
        tmp = path.with_name(path.name + ".accept")
        tmp.write_text(text)
        os.replace(tmp, path)


def scenario_a(leg: Leg, a) -> tuple[Path | None, list[tuple[str, Path]]]:
    e = leg.env("a", isabelle_at(a, a.isabelle_build), a.top)
    if not e:
        return None, []
    chain = leg.chain(e)
    names = [f for f, _ in chain]
    leg.check("(a) one applied line naming the chain bottom first", leg.times(f"changed (applied: {', '.join(names)})") == 1
              and leg.times("changed (applied:") == 1)
    leg.check("(a) one heap paragraph", leg.times(texts.HEAP_PARAGRAPH) == 1)
    leg.check("(a) no hook failure text", leg.times("the hook could not run") == 0 and leg.times("could not run, so") == 0)
    leg.check("(a) status: every feature applied, exit 0", leg.all_applied(e))
    if a.component:
        leg.check(f"(a) {a.component} registered", leg.registered(e, a.component))
    r = subprocess.run([str(leg.python(e)), "-I", "-c", "from isabelle_patch_control.engine import Git; print(Git().exe)"],
                       capture_output=True, text=True)
    own = e / ("Library/bin/git.exe" if WINDOWS else "bin/git")
    same = r.returncode == 0 and os.path.normcase(os.path.realpath(r.stdout.strip())) == os.path.normcase(os.path.realpath(own))
    leg.check("(a) the tool runs the git of its own environment", same, r.stdout + r.stderr)
    if WINDOWS:
        longpaths(leg, e)
    untouched = Path("isa") / "etc" / "ISABELLE_IDENTIFIER"            # no feature patches it
    leg.check("(a) conda hard-linked the tree from the package cache, as on a user's machine",
              os.path.samefile(e / untouched, leg.isabelle_dir(e) / untouched))
    if a.subdir:
        leg.check(f"(a) the environment is {a.subdir}", leg.records(e)["python"]["subdir"] == a.subdir)
    if a.session_dir:
        r = subprocess.run([str(leg.isabelle(e)), "build", "-D", a.session_dir], capture_output=True, text=True)
        leg.check("(a) the session using the component builds", r.returncode == 0, r.stdout + r.stderr)
    leg.bytes_ok("after (a)", e, names)
    return e, chain


LONGPATHS_PROBE = r"""
import sys
from pathlib import Path
from isabelle_patch_control.engine import Git
root = Path(sys.argv[1])
work = root / ("w" * (200 - len(str(root)) - 1))     # git's working directory: about 200 characters, under its 260 cap
rel = "d" * 60 + "/" + "f" * 10                      # the target: about 272 characters
patch = work / ("p" * 70 + ".patch")                 # the patch file: about 277 characters
(work / rel).parent.mkdir(parents=True)
(work / rel).write_bytes(b"a\n")
patch.write_bytes(b"--- a/%s\n+++ b/%s\n@@ -1 +1 @@\n-a\n+b\n" % (rel.encode(), rel.encode()))
off = Git().run(work, "-c", "core.longpaths=false", "apply", "--numstat", str(patch))   # the last -c wins
on = Git().run(work, "apply", "--whitespace=nowarn", str(patch))
print(off.returncode, on.returncode, (work / rel).read_bytes() == b"b\n")
print(off.stderr.decode(errors="replace"), on.stderr.decode(errors="replace"))
"""


def longpaths(leg: Leg, e: Path):
    """core.longpaths takes effect (plan decision 15): the tool's git applies a patch whose file and
    target are over 260 characters, and fails with the flag turned off; git ignores a key it does not
    know, so a run that merely accepts the flag would show nothing."""
    root = leg.work / "longpaths"
    shutil.rmtree(root, ignore_errors=True)
    root.mkdir()
    r = subprocess.run([str(leg.python(e)), "-I", "-c", LONGPATHS_PROBE, str(root)], capture_output=True, text=True)
    first = r.stdout.split()[:3]
    leg.check("(a) core.longpaths: paths over 260 characters apply, and fail with the flag off",
              r.returncode == 0 and first[:1] != ["0"] and first[1:] == ["0", "True"], r.stdout + r.stderr)


def scenario_b(leg: Leg, a, chain):
    names = [f for f, _ in chain]
    feature = feature_name(a.component or a.top)
    below = names[:names.index(feature)]
    e = leg.env("b1", isabelle_at(a, a.isabelle_build), TOOL, *(package_name(f) for f in below), package_name(feature))
    if e:
        packages = [d for _, d in leg.chain(e)]
        user = leg.user_dir(e)
        leg.conda("remove", e, package_name(feature))
        leg.check(f"(b) removing {package_name(feature)}: the features below still applied",
                  leg.states(e) == [f"applied {f}" for f in below])
        if a.component:
            leg.check(f"(b) {a.component} no longer registered", not leg.registered(e, a.component))
            leg.check("(b) the user directory is still there (isabelle was asked for)", bool(user and user.is_dir()))
        leg.bytes_ok(f"after removing {package_name(feature)}", e, below, packages)
    e = leg.env("b2", isabelle_at(a, a.isabelle_build), *(package_name(f) for f in names))
    if e:
        packages = [d for _, d in leg.chain(e)]
        leg.conda("remove", e, a.top)
        leg.check("(b, pruning i) the lower packages asked for: only the top's pre-unlink ran", leg.times(" was undone") == 1)
        leg.bytes_ok("after pruning (i)", e, names[:-1], packages)
    e = leg.env("b3", isabelle_at(a, a.isabelle_build), a.top)
    if e:
        packages = [d for _, d in leg.chain(e)]
        leg.conda("remove", e, a.top)
        leg.check("(b, pruning ii) only the top asked for: every pre-unlink ran, top first",
                  [leg.out.find(f"{f} was undone") for f in reversed(names)] == sorted(leg.out.find(f"{f} was undone") for f in names)
                  and leg.times(" was undone") == len(names))
        leg.check("(b, pruning ii) the tool went too", TOOL not in leg.records(e))
        leg.bytes_ok("after pruning (ii)", e, [], packages)
    e = leg.env("b4", isabelle_at(a, a.isabelle_build), a.top)
    if e:
        packages = [d for _, d in leg.chain(e)]
        leg.conda("remove", e, "--force", a.top)
        leg.check("(b, pruning iii) --force: only the top removed", leg.states(e) == [f"applied {f}" for f in names[:-1]])
        leg.bytes_ok("after pruning (iii)", e, names[:-1], packages)


def scenario_c(leg: Leg, a):
    if leg.lacks("(c)", "--other-component"):
        return
    e = leg.env("c", isabelle_at(a, a.isabelle_build), a.top, a.other_component)
    if not e:
        return
    leg.check("(c) before: all applied", leg.all_applied(e))
    leg.conda("install", e, "--force-reinstall", "isabelle")
    leg.check("(c) --force-reinstall isabelle: still all applied", leg.all_applied(e))
    leg.check("(c) one re-apply record", leg.times("changed (applied:") == 1)
    for p in filter(None, [a.component, a.other_component]):
        leg.check(f"(c) {p} still registered", leg.registered(e, p))


def scenario_d(leg: Leg, a, e_a: Path | None):
    if not e_a:
        leg.skip("(d): no environment (a)")
        return
    clone = leg.work / "envs" / "d"
    rc = leg.conda("create", clone, "--clone", str(e_a))
    leg.check("(d) --clone: the same state", rc == 0 and leg.states(clone) == leg.states(e_a))


def scenario_e(leg: Leg, a):
    if leg.lacks("(e)", "--other-component") or leg.lacks("(e)", "--non-pristine-build"):
        return
    subject = a.component or a.top
    e = leg.env("e", isabelle_at(a, a.non_pristine_build), a.other_component)
    if not e:
        return
    leg.conda("install", e, subject)
    leg.check(f"(e) installing {subject} moved isabelle to {isabelle_at(a, a.isabelle_build)}",
              isabelle_of(leg.records(e)["isabelle"]) == isabelle_at(a, a.isabelle_build))
    leg.check("(e) the chain applied", leg.all_applied(e))
    leg.check(f"(e) {a.other_component} registered again by the new post-link", leg.registered(e, a.other_component))


def scenario_f(leg: Leg, a, chain):
    feature = feature_name(a.component or a.top)
    names = [f for f, _ in chain]
    k = names.index(feature)
    unpacked, below = chain[k][1], [d for _, d in chain[:k]]
    lower = [package_name(f) for f in names[:k]]
    full = texts.stopped(feature)
    for case, created in (("f1", False), ("f2", True)):
        path = leg.target(unpacked, created, below)
        if path is None:
            leg.skip(f"({case}): {package_name(feature)} has no {'created' if created else 'changed'} file of its own")
            continue
        e = leg.env(case, isabelle_at(a, a.isabelle_build), *lower)
        if not e:
            continue
        p = e / "isa" / path
        p.parent.mkdir(parents=True, exist_ok=True)
        leg.replace_file(p, "a user's own content\n")                     # a new file (§6 (f1))
        rc = leg.conda("install", e, package_name(feature))
        leg.check(f"({case}) the install succeeded and history is there", rc == 0 and (e / "conda-meta" / "history").is_file())
        leg.check(f"({case}) one complete diagnostic naming {path}", leg.times(full) == 1 and path in leg.out)
        leg.check(f"({case}) CONFLICT at {feature}, the features below applied",
                  leg.states(e) == [f"applied {f}" for f in names[:k]] + [f"CONFLICT {feature}"])
        leg.conda("install", e, "--force-reinstall", "isabelle")
        if created:
            leg.check("(f2) --force-reinstall isabelle, the CONFLICT still there: one complete diagnostic", leg.times(full) == 1)
        else:
            leg.check("(f1) --force-reinstall isabelle: all applied, no diagnostic",
                      leg.all_applied(e) and leg.times(full) == 0 and leg.times(texts.IS_CONFLICT) == 0)


def scenario_g(leg: Leg, a):
    for case, specs in (("g1", [a.top]), ("g2", [])):
        e = leg.env(case, isabelle_at(a, a.isabelle_build), *specs)
        if not e:
            continue
        targets = [check_bytes.header(p)[0] for _, d in leg.chain(e) for p in (d / FD).glob("*/*.patch")]
        user = leg.user_dir(e)
        if not leg.check(f"({case}) isabelle names its user directory", user is not None):
            continue
        (user / "heaps" / "HOL").mkdir(parents=True, exist_ok=True)          # a user's heaps, so "gone" means deleted
        leg.conda("remove", e, "isabelle")
        isa = e / "isa"
        if WINDOWS:
            left = [p.relative_to(isa).as_posix() for p in isa.rglob("*") if p.is_file()] if isa.exists() else []
            leg.check(f"({case}) no patch target left", not any((isa / t).exists() for t in targets))
            leg.check(f"({case}) no isa.staging", not list(e.glob("isa.staging*")))
            leg.check(f"({case}) only contrib/cygwin/ left under isa/", all(x.startswith("contrib/cygwin/") for x in left))
        else:
            leg.check(f"({case}) no isa/ left", not isa.exists())
        leg.check(f"({case}) no user directory left", not user.exists())


def scenario_h(leg: Leg, a):
    if leg.lacks("(h)", "--old-build"):
        return
    e = leg.env("h", isabelle_at(a, a.old_build), a.top, TOOL, channels=a.start_channel)
    if not e:
        return
    line = f"isabelle=={a.isabelle_version}"            # `update --all` would move to the newest release line
    leg.conda("install", e, "--update-all", line)
    recs = leg.records(e)
    leg.check(f"(h) install --update-all {line} moved isabelle to {isabelle_at(a, a.isabelle_build)}",
              isabelle_of(recs["isabelle"]) == isabelle_at(a, a.isabelle_build))
    pins = []
    for feature, pkg in leg.chain(e):
        release = provenance_fields((pkg / FD / feature / "provenance.txt").read_text())["release_tag"].split("/")[0]
        pins.append(pinned_build(recs[package_name(feature)], build_string_prefix(release)))
    leg.check("(h) every feature package pins it", bool(pins) and set(pins) == {a.isabelle_build}, str(pins))
    leg.check("(h) all applied", leg.all_applied(e))


def scenario_i(leg: Leg, a, chain):
    if leg.lacks("(i)", "--non-pristine-build"):
        return
    if not chain:
        leg.skip("(i): no environment (a)")
        return
    e = leg.env("i", isabelle_at(a, a.non_pristine_build), TOOL)
    if not e:
        return
    rc, out = leg.tool(e, "status")
    leg.check("(i) only the tool: exit 0, no feature packages installed", rc == 0 and texts.NO_FEATURES in out, out)
    bottom, unpacked = chain[0]                       # its base_tag is the pristine tag the tree is checked against
    shutil.copytree(unpacked / FD / bottom, e / FD / bottom)
    rc, out = leg.tool(e, "status")
    leg.check(f"(i) a feature directory on build {a.non_pristine_build}: exit 3, the update that keeps isabelle "
              f"{a.isabelle_version}, with both channels",
              rc == 3 and "To fix it, run: conda install -p " in out
              and out.rstrip().endswith(f' --update-all "isabelle=={a.isabelle_version}" {texts.CHANNELS}'), out)


def scenario_j(leg: Leg, a):
    repo = leg.work / "worktree"
    repo.mkdir(exist_ok=True)
    subprocess.run(["git", "init", "-q", str(repo)], check=True)
    e = leg.env("j", isabelle_at(a, a.isabelle_build), a.top, under=repo)
    if e:
        leg.check("(j) under a git work tree: every feature applied", leg.all_applied(e))
        leg.bytes_ok("under a git work tree", e, [f for f, _ in leg.chain(e)])


def scenario_l(leg: Leg, a, e_a: Path | None):
    if not WINDOWS or not e_a:
        return
    t = time.monotonic(); rc_status, _ = leg.tool(e_a, "status"); status_s = time.monotonic() - t
    rc, out = leg.tool(e_a, "unapply")
    leg.check("(l) unapply: exit 0, no feature applied", rc == 0 and leg.states(e_a) == [f"not-applied {f}" for f, _ in leg.chain(e_a)], out)
    t = time.monotonic(); rc_apply, out = leg.tool(e_a, "apply"); apply_s = time.monotonic() - t
    print(f"measured status {status_s:.1f} s, apply of the whole chain {apply_s:.1f} s")
    leg.check("(l) status and the whole apply: exit 0, all applied, each within 30 s",
              rc_status == 0 and rc_apply == 0 and leg.all_applied(e_a) and status_s <= 30 and apply_s <= 30, out)


def scenario_m(leg: Leg, a, chain):
    if not chain:
        leg.skip("(m): no environment (a)")
        return
    bottom = chain[0][0]
    pre = f"isabelle-patch-control could not run, so {bottom} may still be applied"
    cannot_start = "isabelle-patch-control: the hook could not run."
    cases = [("m1", "no tool", None, "isabelle-patch-control is not installed, so the installed Isabelle feature packages are not applied."),
             ("m2", "a tool that cannot start", 'raise RuntimeError("accept (m): a tool that cannot start")\n', cannot_start)]
    if WINDOWS:     # a negative exit code: decision 9's two-line errorlevel test, so far measured only under wine
        cases.append(("m3", "a tool that exits with an NTSTATUS code", "import os\nos._exit(-1073741819)\n", cannot_start))
    for case, what, init, post in cases:
        e = leg.env(case, isabelle_at(a, a.isabelle_build), a.top)
        if not e:
            continue
        if init is None:
            leg.conda("remove", e, "--force", TOOL)
        else:
            r = subprocess.run([str(leg.python(e)), "-I", "-c", "import isabelle_patch_control as m; print(m.__file__)"],
                               capture_output=True, text=True)
            leg.replace_file(Path(r.stdout.strip()), init)
        rc = leg.conda("install", e, "--no-deps", "--force-reinstall", package_name(bottom))   # without --no-deps the tool comes back
        leg.check(f"({case}) {what}: the install succeeded and history is there", rc == 0 and (e / "conda-meta" / "history").is_file())
        leg.check(f"({case}) {what}: the pre-unlink and the post-link say so once each", leg.times(pre) == 1 and leg.times(post) == 1)


def scenario_n(leg: Leg, a, e_a: Path | None, chain):
    if not WINDOWS or not e_a:
        return
    tree = e_a / "isa"
    the_id = (tree / "etc" / "ISABELLE_ID").read_text().strip()
    holder = subprocess.Popen([str(leg.python(e_a)), "-I", "-c",
                               "import sys; from pathlib import Path; from isabelle_patch_control import engine\n"
                               "with engine.locked(Path(sys.argv[1]), True):\n    print('locked', flush=True); sys.stdin.read()",
                               str(tree)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    try:
        leg.check("(n) a helper holds the lock", holder.stdout.readline().strip() == "locked")
        r = subprocess.run(["cmd", "/c", "type", str(tree / "etc" / "ISABELLE_ID")], capture_output=True, text=True)
        leg.check("(n) while it is held, type etc\\ISABELLE_ID works", r.returncode == 0 and the_id in r.stdout, r.stdout + r.stderr)
        r = subprocess.run([str(leg.isabelle(e_a)), "version", "-i"], capture_output=True, text=True)
        leg.check("(n) while it is held, isabelle version -i works", r.returncode == 0 and the_id in r.stdout, r.stdout + r.stderr)
        t = time.monotonic(); rc, out = leg.tool(e_a, "status"); waited = time.monotonic() - t
        leg.check(f"(n) a second status is busy after the {engine.LOCK_TIMEOUT:.0f} s limit ({waited:.0f} s)",
                  rc == 1 and "another isabelle-patch-control run holds the lock" in out
                  and engine.LOCK_TIMEOUT <= waited < engine.LOCK_TIMEOUT + 30, out)
    finally:
        holder.communicate("")
    bottom, unpacked = chain[0]
    changed = [h[0] for p in sorted((unpacked / FD / bottom).glob("*.patch")) if set((h := check_bytes.header(p))[1]) != {"0"}]
    target = tree / changed[0]
    os.chmod(target, stat.S_IREAD)
    rc, out = leg.tool(e_a, "unapply")
    leg.check("(n) a read-only target: unapply exits 1 with a message, no traceback", rc == 1 and "Traceback" not in out, out)
    os.chmod(target, stat.S_IREAD | stat.S_IWRITE)
    rc, out = leg.tool(e_a, "apply")
    leg.check("(n) the attribute cleared: apply converges, all applied", rc == 0 and leg.all_applied(e_a), out)
    opener = subprocess.Popen([sys.executable, "-I", "-c", "import sys\nf = open(sys.argv[1], 'rb'); print('open', flush=True); sys.stdin.read()",
                               str(target)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    try:                     # held throughout; decision 5's retries are a pytest (tests/test_write.py)
        opener.stdout.readline()
        probe = target.with_name(target.name + ".accept")
        shutil.copyfile(target, probe)
        try:
            os.replace(probe, target)
            refused = False
        except PermissionError:
            refused = True
        probe.unlink(missing_ok=True)
        leg.check("(n) a target held open by another process: Windows refuses to replace it", refused)
        rc, out = leg.tool(e_a, "unapply")
        leg.check("(n) and unapply exits 1 with a message, no traceback", rc == 1 and bool(out.strip()) and "Traceback" not in out, out)
    finally:
        opener.communicate("")
    rc, out = leg.tool(e_a, "unapply")
    leg.check("(n) released: unapply succeeds", rc == 0, out)
    leg.bytes_ok("after unapply with the target released", e_a, [])
    rc, out = leg.tool(e_a, "apply")
    leg.check("(n) apply again: all applied", rc == 0 and leg.all_applied(e_a), out)


def describe() -> str:
    """What a failure on a runner is read against: conda and its solver, the channel priority,
    CONDA_SUBDIR, the bash on PATH."""
    def out(*args: str) -> str:
        return subprocess.run(list(args), capture_output=True, text=True).stdout
    base = {d["name"]: d["version"] for d in json.loads(out(CONDA, "list", "-n", "base", "--json") or "[]")
            if d["name"] in ("conda", "conda-libmamba-solver", "libmambapy")}
    config = json.loads(out(CONDA, "config", "--show", "solver", "channel_priority", "--json") or "{}")
    bash = shutil.which("bash")
    return (f"conda: {base}, solver {config.get('solver')}, channel_priority {config.get('channel_priority')}, "
            f"CONDA_SUBDIR={os.environ.get('CONDA_SUBDIR', '')!r}, bash {bash}: "
            f"{out(bash, '--version').splitlines()[0] if bash else 'none'}")


def cli():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--isabelle-version", required=True, help="the batch's isabelle version (release-plan's isabelle_version)")
    p.add_argument("--isabelle-build", required=True)
    p.add_argument("--top", required=True, help="the chain top's package")
    p.add_argument("--component", help="the feature package that ships an Isabelle component")
    p.add_argument("--other-component", help="an Isabelle_RPC-style component package for (c) and (e)")
    p.add_argument("--session-dir", help="a session directory using the component, built in (a)")
    p.add_argument("--old-build", default="", help="the build's isabelle_old_build output; empty skips (h)")
    p.add_argument("--non-pristine-build", default="", help="the build of that version on the online channel that was not "
                   "built from the pristine sources (2025.2: 0, which carries expose_foreign); empty skips (e) and (i)")
    p.add_argument("--channel", action="append", required=True, help="the accept channels, in order")
    p.add_argument("--start-channel", action="append", help="the channels of (h)'s first environment (decision 11's one exception)")
    p.add_argument("--work", help="where the environments go")
    p.add_argument("--only", nargs="*", help="run only these scenarios (a b c d e f g h i j l m n)")
    p.add_argument("--subdir", help="the leg's conda subdir; (a) checks its environment is of it")
    p.add_argument("--strict", action="store_true", help="a skipped scenario is wrong, unless an empty option asks for the skip")
    a = p.parse_args()
    leg = Leg(a)
    print(describe())
    run = set(a.only or "abcdefghijlmn")
    e_a, chain = scenario_a(leg, a) if run & set("abdfilmn") else (None, [])   # the chain the others work on
    for name in "bf":
        if name in run and not chain:
            leg.skip(f"({name}): no environment (a)")
    if "b" in run and chain:
        scenario_b(leg, a, chain)
    if "c" in run:
        scenario_c(leg, a)
    if "e" in run:
        scenario_e(leg, a)
    if "f" in run and chain:
        scenario_f(leg, a, chain)
    if "g" in run:
        scenario_g(leg, a)
    if "h" in run:
        scenario_h(leg, a)
    if "j" in run:
        scenario_j(leg, a)
    if "m" in run:
        scenario_m(leg, a, chain)
    if "d" in run:
        scenario_d(leg, a, e_a)
    if "i" in run:
        scenario_i(leg, a, chain)
    if "l" in run:
        scenario_l(leg, a, e_a)
    if "n" in run:
        scenario_n(leg, a, e_a, chain)
    print(f"--- {leg.passed} passed, {len(leg.failed)} wrong ({leg.envs} environments under {leg.work})")
    for f in leg.failed:
        print(f"  wrong: {f}")
    return 1 if leg.failed else 0


if __name__ == "__main__":
    sys.exit(cli())
