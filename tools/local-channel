#!/usr/bin/env bash
# local-channel <channel dir> <isabelle version> <isabelle build> <feature-packages dir> [<conda-packages dir>]
#
# The release workflow's local channel (patch tool plan decision 11): the batch's feature-packages
# artifact (noarch/*.conda) and, in a rehearsal, the CI run's conda-packages artifact
# (<subdir>/*.conda), indexed with conda-index into the base environment's python.  The rehearsal's
# isabelle packages must be exactly the batch's isabelle-<version>-<build>; that the online channel
# does not serve this build yet, release-plan --rehearsal has checked.
set -euo pipefail
ch=$1 v=$2 b=$3 features=$4 ci=${5-}
conda install -q -y -n base -c conda-forge conda-index
mkdir -p "$ch/noarch"
find "$features" -name '*.conda' -exec cp {} "$ch/noarch/" \;
if [ -n "$ci" ] && [ -d "$ci" ]; then
  # one loop over the files, quoted throughout: a Windows RUNNER_TEMP (D:\a\_temp) holds backslashes
  # that a second glob over the expanded path would read as escapes
  for f in "$ci"/*/*.conda; do
    [ -e "$f" ] || continue
    sub=$(basename "$(dirname "$f")")
    mkdir -p "$ch/$sub"
    cp "$f" "$ch/$sub/"
  done
  found=$(find "$ch" -name 'isabelle-[0-9]*.conda' | sed 's|.*/||' | sort -u)
  [ "$found" = "isabelle-$v-$b.conda" ] || { echo "::error::the CI run's isabelle packages are '$found', the batch pins isabelle-$v-$b.conda"; exit 1; }
fi
python -m conda_index "$ch" --no-zst --no-bz2 --channel-name local
find "$ch" -name '*.conda' | sort
