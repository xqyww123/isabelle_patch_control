#!/usr/bin/env python3
"""advance-daily [-C <dir>] [--to <commit>] <R> <session>...

Fast-forwards the shared tree of release line <R> (branch <R>/daily) to a tested commit of
<R>/dev_patches: the tip, or --to.  Run on the owner's order (migration plan §3, §7 rule 13).

Refused unless: the shared tree's HEAD is the symbolic ref <R>/daily; <R>/daily is an ancestor of
<R>/dev_patches; the shared tree's git status is empty; the target is on <R>/dev_patches and
ahead of <R>/daily; the target carries tested records whose session sets together cover the
sessions named on the command line.  The records are printed.  The sessions that depend on the
shared tree are listed and must be confirmed notified before the merge.  Afterwards the heap
rebuild command is printed, not run: a build needs the owner's authorization.
"""
import argparse
import os
import sys
from pathlib import Path

from common import Refused, Repo, main, run

CONSUMERS = ("TAT (every node-class session using the shared tree's heaps)",
             "Isa-REPL servers started from the shared tree",
             "isabelle-mcp servers (`isabelle mcp_server`) on the shared tree",
             "jEdit or other PIDE front ends on the shared tree")


def cli():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-C", metavar="dir", default=os.getcwd(), help="a directory inside the repository")
    p.add_argument("--to", metavar="commit", help="a commit on <R>/dev_patches instead of its tip")
    p.add_argument("release", metavar="<R>")
    p.add_argument("sessions", metavar="session", nargs="+", help="sessions the tested records must cover")
    a = p.parse_args()
    repo = Repo(Path(a.C))
    repo.check_hook()
    daily, top = f"{a.release}/daily", f"{a.release}/dev_patches"
    shared = repo.shared_tree(a.release)
    if Repo.head_branch(shared) != daily:
        raise Refused(f"{shared} is not on {daily}")
    if not repo.is_ancestor(daily, top):
        raise Refused(f"{daily} is not an ancestor of {top}")
    if Repo.status(shared):
        raise Refused(f"{shared} has a non-empty git status")
    target = repo.rev(a.to or top)
    if not repo.is_ancestor(target, top):
        raise Refused(f"{target[:12]} is not on {top}")
    if target == repo.rev(daily):
        print(f"{daily} is already at {target[:12]}; nothing to do")
        return 0
    if not repo.is_ancestor(daily, target):
        raise Refused(f"{target[:12]} is not ahead of {daily}")
    records = repo.tested_records(target)
    if not records:
        raise Refused(f"{target[:12]} has no tested record")
    print(f"tested records of {target[:12]}:")
    covered = set()
    for r in records:
        print(f"  {r['when']} in {r['tree']}: {r['command']} -> {' '.join(sorted(r['sessions']))}")
        covered |= r["sessions"]
    missing = sorted(set(a.sessions) - covered)
    if missing:
        raise Refused(f"the tested records do not cover {' '.join(missing)}")
    print(f"\n{daily}: {repo.rev(daily)[:12]} -> {target[:12]}  (covers {' '.join(a.sessions)})")
    print("Sessions that depend on the shared tree, to be notified and stopped before the merge:")
    for c in CONSUMERS:
        print(f"  - {c}")
    answer = input("Type 'notified' once they are: ") if sys.stdin.isatty() or True else ""
    if answer.strip() != "notified":
        raise Refused("not confirmed; nothing was changed")
    r = run(["git", "merge", "--ff-only", target], cwd=shared)
    print(r.stdout.strip())
    print(f"{daily} is now at {repo.rev(daily)[:12]}")
    print("Rebuild the heaps (needs the owner's authorization; not run by this script):")
    print(f"  cd {shared} && bin/isabelle build -b {' '.join(a.sessions)}")


main(cli)
