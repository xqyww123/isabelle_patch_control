#!/usr/bin/env python3
"""check-packages --plan <plan.json> [--summary <file>] <file.conda>...

The build job's look inside every package of a batch before anything is installed (patch tool plan
decision 11): every file is noarch; a feature package
has both hook sets, its .sh hooks are LF, its .bat hooks are CRLF throughout, its feature directory
holds provenance.txt and patch files, its README is there, and when it ships a component the
post-link names that component's directory literally; the tool package ships its hook fragments.

The packages are exactly the files of release-plan's plan.json.  --summary writes
{"environments": [...]}, one for each feature package that no other package of the batch is built on,
sorted by release tag: its release_tag, package, version, feature, batch_release_tags (the release
tags of the batch in its environment, sorted), isabelle_old_build (the plan's) and install (its
README's first `conda create -n ` line, the common text's), for the jobs after the build.
"""
import argparse
import json
from pathlib import Path

from common import Refused, conda_archive, direct_dependencies, entries, main, ships_component
from isabelle_patch_control.features import provenance_fields
from isabelle_patch_control.names import feature_name

TOOL = "isabelle-patch-control"
FRAGMENTS = [f"site-packages/isabelle_patch_control/hooks/{h}" for h in ("post-link.sh", "post-link.bat", "pre-unlink.sh", "pre-unlink.bat")]


def problems_of(path: Path, index: dict, files: dict) -> list[str]:
    name, out = index["name"], []
    if index.get("subdir") != "noarch" or path.parent.name != "noarch":
        out.append(f"not a noarch package under noarch/ (subdir {index.get('subdir')!r})")
    if name == TOOL:
        out += [f"missing {f}" for f in FRAGMENTS if f not in files]
        return out
    feature = feature_name(name)
    if feature is None:
        return [f"{name} is neither the tool nor a feature package"]
    hooks = {f"bin/.{name}-{h}.sh": False for h in ("post-link", "pre-unlink")}
    hooks |= {f"Scripts/.{name}-{h}.bat": True for h in ("post-link", "pre-unlink")}
    for rel, crlf in hooks.items():
        if rel not in files:
            out.append(f"missing {rel}")
            continue
        data, mode = files[rel]
        if crlf and (not data.endswith(b"\r\n") or b"\n" in data.replace(b"\r\n", b"")):
            out.append(f"{rel} is not CRLF throughout")
        if not crlf and b"\r" in data:
            out.append(f"{rel} has a carriage return")
        if not crlf and not mode & 0o100:
            out.append(f"{rel} is not executable")
    fd = f"share/isabelle_patch_control/features.d/{feature}/"
    if f"{fd}provenance.txt" not in files or not any(f.startswith(fd) and f.endswith(".patch") for f in files):
        out.append(f"{fd} lacks provenance.txt or a patch file")
    if f"share/doc/{name}/README.md" not in files:
        out.append(f"missing share/doc/{name}/README.md")
    if ships_component(index, files):
        post = files.get(f"bin/.{name}-post-link.sh", (b"", 0))[0]
        if f'"$PREFIX/share/{name}"'.encode() not in post:
            out.append(f"the post-link does not register share/{name}, where the component is installed")
    return out


def provenance_of(index: dict, files: dict) -> dict[str, str]:
    feature = feature_name(index["name"])
    return provenance_fields(files[f"share/isabelle_patch_control/features.d/{feature}/provenance.txt"][0].decode())


def install_line(index: dict, files: dict) -> str:
    readme = files[f"share/doc/{index['name']}/README.md"][0].decode()
    return next(line for line in readme.splitlines() if line.startswith("conda create -n "))


def environments(archives: dict[Path, tuple[dict, dict]], plan: dict) -> list[dict]:
    """The environments of the summary."""
    planned = {p["tag"]: p for p in plan["packages"] if "tag" in p}
    features = {provenance_of(index, f)["release_tag"]: (index, f) for index, f in archives.values() if index["name"] != TOOL}
    bases = {tag: direct_dependencies(provenance_of(index, f)) for tag, (index, f) in features.items()}
    return [{"release_tag": tag, "package": features[tag][0]["name"], "version": features[tag][0]["version"],
             "feature": tag.split("/")[1], "batch_release_tags": tags,
             "isabelle_old_build": planned[tag]["isabelle_old_build"], "install": install_line(*features[tag])}
            for tag, tags in entries(bases).items()]


def cli():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--plan", type=Path, required=True, help="release-plan's output")
    p.add_argument("--summary", type=Path)
    p.add_argument("packages", nargs="+", type=Path)
    a = p.parse_args()
    archives = {pkg: conda_archive(pkg.read_bytes()) for pkg in a.packages}
    report = [f"{pkg}: {problem}" for pkg, (index, files) in archives.items() for problem in problems_of(pkg, index, files)]
    plan = json.loads(a.plan.read_text())
    files = sorted(p["file"] for p in plan["packages"])
    if sorted(pkg.name for pkg in archives) != files:
        report.append(f"the packages are {' '.join(sorted(pkg.name for pkg in archives))}, the plan's files {' '.join(files)}")
    if report:
        raise Refused("\n  ".join(["the packages are not as the batch needs them:", *report]))
    if a.summary:
        a.summary.write_text(json.dumps({"environments": environments(archives, plan)}, indent=1) + "\n")
    print(f"check-packages: {len(a.packages)} packages as expected")


if __name__ == "__main__":
    main(cli)
