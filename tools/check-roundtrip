#!/usr/bin/env python3
"""check-roundtrip <pristine tree> <top feature> --features-dir FD [-C <Isabelle repository>] [--tool <command>] [--keep]

Check (b2) of the migration plan (patch tool plan decision 17): the chain of feature directories in
FD, applied by the patch tool, gives the same tree as GNU patch applying the Isabelle repository's
diff from the pristine tag to the top feature's release tag; and the tool takes it back.

  copy A of the tree:  <tool> --isabelle-home A --features-dir FD apply; then `status -v` must exit
                       0 and show every file the chain creates under its real path;
  copy B of the tree:  patch -p1 -F0 with `git diff-tree -r -p --no-renames <bottom tag> <top tag>`
                       (GNU patch never skips a patch silently);
  A == B, by `diff -r` and by a sorted `find -printf '%M %P'` listing (modes included); A differs
  from the pristine tree; then `unapply` on A, and A == the pristine tree.

The bottom tag is <R>/pristine/<etc/ISABELLE_ID> of the tree, the top tag the `release_tag` of
FD/<top feature>/provenance.txt.  The repository must hold both tags (-C defaults to the current
directory).  --tool defaults to this checkout's `python -m isabelle_patch_control`; in the release
workflow it is the installed `isabelle-patch-control`.  Runs under umask 022; the copies live in a
temporary directory next to the tree and are removed unless --keep.
"""
import argparse
import os
import re
import shlex
import shutil
import sys
import tempfile
from pathlib import Path

from common import TOOLS_DIR, Refused, main, run


def listing(d: Path) -> list[str]:
    return sorted(run(["find", ".", "-printf", "%M %P\n"], cwd=d).stdout.splitlines())


def same(a: Path, b: Path, what: str):
    r = run(["diff", "-r", "--no-dereference", "-q", a, b], check=False)
    if r.returncode:
        raise Refused(f"{what}: the trees differ:\n{r.stdout.strip()}{r.stderr.strip()}")
    la, lb = listing(a), listing(b)
    if la != lb:
        diff = sorted(set(la) ^ set(lb))
        raise Refused(f"{what}: the listings (modes and paths) differ:\n" + "\n".join(diff[:40]))


def created_files(fd: Path) -> list[str]:
    """Paths that some patch file in FD creates (its block starts with `--- /dev/null`)."""
    out = []
    for p in sorted(fd.glob("*/*.patch")):
        for m in re.finditer(r"(?m)^--- /dev/null\n\+\+\+ b/(.+)$", p.read_text(errors="replace")):
            out.append(m[1])
    return out


def cli():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("tree", type=Path, help="the pristine tree (not modified)")
    p.add_argument("top", help="the chain's top feature (a directory name under FD)")
    p.add_argument("--features-dir", required=True, type=Path, metavar="FD")
    p.add_argument("-C", metavar="dir", default=os.getcwd(), help="a directory inside the Isabelle repository")
    p.add_argument("--tool", default=None, help="the patch tool command (default: this checkout's)")
    p.add_argument("--keep", action="store_true", help="keep the two copies")
    a = p.parse_args()
    os.umask(0o022)
    pristine, fd = a.tree.resolve(), a.features_dir.resolve()
    if not (pristine / "etc" / "ISABELLE_ID").is_file():
        raise Refused(f"{pristine} is not an Isabelle tree (no etc/ISABELLE_ID)")
    release = (pristine / "etc" / "ISABELLE_IDENTIFIER").read_text().strip()
    bottom = f"{release}/pristine/{(pristine / 'etc' / 'ISABELLE_ID').read_text().strip()}"
    provenance = fd / a.top / "provenance.txt"
    if not provenance.is_file():
        raise Refused(f"{provenance} is missing")
    top_tag = next((line.split(":", 1)[1].strip() for line in provenance.read_text().splitlines()
                    if line.startswith("release_tag:")), None)
    if not top_tag:
        raise Refused(f"{provenance} has no release_tag")
    tool = shlex.split(a.tool) if a.tool else [sys.executable, "-m", "isabelle_patch_control"]
    env = {**os.environ, "PYTHONPATH": str(TOOLS_DIR.parent)} if a.tool is None else None

    work = Path(tempfile.mkdtemp(prefix="check-roundtrip-", dir=pristine.parent))
    try:
        A, B = work / "A", work / "B"
        run(["cp", "-a", pristine, A])
        run(["cp", "-a", pristine, B])
        print(f"copies under {work}")

        r = run([*tool, "--isabelle-home", A, "--features-dir", fd, "apply"], env=env, check=False)
        if r.returncode:
            raise Refused(f"the tool's apply on A exited {r.returncode}:\n{r.stdout}{r.stderr}")
        r = run([*tool, "--isabelle-home", A, "--features-dir", fd, "status", "-v"], env=env, check=False)
        if r.returncode:
            raise Refused(f"status after apply exited {r.returncode}:\n{r.stdout}{r.stderr}")
        missing = [f for f in created_files(fd) if f"    {f}  level" not in r.stdout]
        if missing:
            raise Refused("status -v does not show these created files under their real path:\n  " + "\n  ".join(missing))
        print(f"A: applied; status -v shows the {len(created_files(fd))} created files")

        diff = run(["git", "diff-tree", "-r", "-p", "--no-renames", bottom, top_tag], cwd=a.C).stdout
        r = run(["patch", "-p1", "-F0", "--no-backup-if-mismatch", "-d", B], input=diff, check=False)
        if r.returncode:
            raise Refused(f"GNU patch on B exited {r.returncode}:\n{r.stdout}{r.stderr}")
        print(f"B: GNU patch applied {bottom} -> {top_tag}")
        same(A, B, "A (the tool) against B (GNU patch)")
        if listing(A) == listing(pristine) and run(["diff", "-r", "--no-dereference", "-q", A, pristine], check=False).returncode == 0:
            raise Refused("A equals the pristine tree: the chain applied nothing")
        print("A == B, and A differs from the pristine tree")

        r = run([*tool, "--isabelle-home", A, "--features-dir", fd, "unapply"], env=env, check=False)
        if r.returncode:
            raise Refused(f"the tool's unapply on A exited {r.returncode}:\n{r.stdout}{r.stderr}")
        same(A, pristine, "A after unapply against the pristine tree")
        print("A after unapply == the pristine tree")
        print(f"check-roundtrip: ok ({bottom} -> {top_tag})")
    finally:
        if a.keep:
            print(f"kept {work}")
        else:
            shutil.rmtree(work, ignore_errors=True)


main(cli)
