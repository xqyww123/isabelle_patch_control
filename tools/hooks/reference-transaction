#!/bin/sh
# reference-transaction hook of the Isabelle source repository (migration plan §3).  Three rules:
#   refs/heads/<R>/daily   moves only forward, and only onto a commit on <R>/dev_patches;
#   refs/tags/<R>/<f>/<v>  a release tag never changes once it exists;
#   refs/heads/*           a branch is created only with ISABELLE_GIT_OWNER=1 in the environment.
# The ref's current value is read here (git passes zeros as <old> when the caller gave none).  A
# line that deletes a ref or leaves its value unchanged passes: `git pack-refs` (hence `gc`)
# re-sends every ref as "0 <oid>" and then prunes the loose copy as "<oid> 0".
[ "$1" = prepared ] || exit 0
Z=0000000000000000000000000000000000000000
refuse() { echo "reference-transaction hook refused: $*" >&2; exit 1; }
while read -r _old new ref; do
  [ "$new" = "$Z" ] && continue
  cur=$(git rev-parse -q --verify "$ref") || cur=
  [ "$cur" = "$new" ] && continue
  case "$ref" in
    refs/heads/*)
      [ -n "$cur" ] || [ "${ISABELLE_GIT_OWNER:-}" = 1 ] \
        || refuse "creating branch ${ref#refs/heads/} needs ISABELLE_GIT_OWNER=1 (only the owner opens branches)" ;;
  esac
  case "$ref" in
    refs/heads/*/daily)
      top=${ref%/daily}/dev_patches
      if [ -n "$cur" ] && ! git merge-base --is-ancestor "$cur" "$new"; then
        refuse "${ref#refs/heads/} would not fast-forward"; fi
      git merge-base --is-ancestor "$new" "$top" 2>/dev/null \
        || refuse "${ref#refs/heads/} may only move onto a commit on ${top#refs/heads/}" ;;
    refs/tags/*/*/*)
      [ -z "$cur" ] || refuse "release tag ${ref#refs/tags/} already exists and never changes" ;;
  esac
done
exit 0
